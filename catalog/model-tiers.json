{
  "version": 1,
  "checked": "2026-10-27",
  "doc": "docs/MODEL_TIERS.md",
  "default_tier": "low",
  "providers": {
    "anthropic": {
      "list": "GET https://api.anthropic.com/v1/models",
      "newest_by": "created_at",
      "tiers": {
        "low": { "pattern": "^claude-haiku-", "pinned": "claude-haiku-5-5", "verified": true },
        "medium": { "pattern": "^claude-sonnet-", "pinned": "claude-sonnet-5-5", "verified": true },
        "high": { "pattern": "^claude-opus-", "pinned": "claude-opus-5-5", "verified": true }
      }
    },
    "openai": {
      "list": "GET https://api.openai.com/v1/models",
      "newest_by": "created",
      "tiers": {
        "low": { "pattern": "^gpt-[0-9.]+-luna$", "pinned": "gpt-6-luna", "verified": false },
        "medium": { "pattern": "^gpt-[0-9.]+-terra$", "pinned": "gpt-6.1-terra", "verified": false },
        "high": { "pattern": "^gpt-[0-9.]+-sol$", "pinned": "gpt-6.1-sol", "verified": false }
      }
    },
    "google": {
      "list": "GET https://generativelanguage.googleapis.com/v1beta/models",
      "newest_by": "alias, else highest version in the name",
      "tiers": {
        "low": { "pattern": "^gemini-[0-9.]+-flash-lite$", "alias": "gemini-flash-lite-latest", "pinned": "gemini-3.5-flash-lite", "verified": false },
        "medium": { "pattern": "^gemini-[0-9.]+-flash$", "alias": "gemini-flash-latest", "pinned": "gemini-flash-latest", "verified": false },
        "high": { "pattern": "^gemini-[0-9.]+-pro$", "alias": "gemini-pro-latest", "pinned": "gemini-pro-latest", "verified": false }
      }
    }
  }
}
